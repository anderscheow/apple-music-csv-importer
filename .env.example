# Create a MusicKit identifier and private key in Apple Developer.
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_MUSIC_KEY_ID=YOUR_KEY_ID
# Paste the .p8 key with literal \n between lines, or use APPLE_MUSIC_PRIVATE_KEY_PATH.
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_MUSIC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
PORT=3001
